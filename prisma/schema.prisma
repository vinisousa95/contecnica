generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true) @map("is_active")
  phone        String?
  avatar       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  expenses            Expense[]
  revenues            Revenue[]
  appSubmissions      AppSubmission[]
  reviewedSubmissions AppSubmission[] @relation("ReviewedBy")
  budgets             Budget[]

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

// ─────────────────────────────────────────────
// CLIENTS
// ─────────────────────────────────────────────
model Client {
  id           String       @id @default(cuid())
  name         String
  document     String?      @unique
  phone        String?
  email        String?
  zipCode      String?      @map("zip_code")
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  notes        String?
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  projects Project[]
  revenues Revenue[]
  budgets  Budget[]

  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

// ─────────────────────────────────────────────
// PROJECTS (OBRAS)
// ─────────────────────────────────────────────
model Project {
  id              String        @id @default(cuid())
  name            String
  clientId        String        @map("client_id")
  client          Client        @relation(fields: [clientId], references: [id])
  zipCode         String?       @map("zip_code")
  street          String?
  number          String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?
  description     String?
  startDate       DateTime?     @map("start_date")
  expectedEndDate DateTime?     @map("expected_end_date")
  actualEndDate   DateTime?     @map("actual_end_date")
  status          ProjectStatus @default(PLANNING)
  budget          Decimal?      @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  expenses       Expense[]
  revenues       Revenue[]
  appSubmissions AppSubmission[]

  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// CATEGORIES
// ─────────────────────────────────────────────
model Category {
  id        String       @id @default(cuid())
  name      String       @unique
  type      CategoryType
  color     String?
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")

  expenses Expense[]
  revenues Revenue[]

  @@map("categories")
}

enum CategoryType {
  EXPENSE
  INCOME
  BOTH
}

// ─────────────────────────────────────────────
// EXPENSES (CONTAS A PAGAR)
// ─────────────────────────────────────────────
model Expense {
  id            String        @id @default(cuid())
  projectId     String?       @map("project_id")
  project       Project?      @relation(fields: [projectId], references: [id])
  categoryId    String?       @map("category_id")
  category      Category?     @relation(fields: [categoryId], references: [id])
  createdById   String        @map("created_by_id")
  createdBy     User          @relation(fields: [createdById], references: [id])
  description   String
  supplier      String?
  amount        Decimal       @db.Decimal(12, 2)
  dueDate       DateTime      @map("due_date")
  paymentDate   DateTime?     @map("payment_date")
  status        ExpenseStatus @default(PENDING)
  paymentMethod String?       @map("payment_method")
  attachmentUrl String?       @map("attachment_url")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("expenses")
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
}

// ─────────────────────────────────────────────
// REVENUES (CONTAS A RECEBER)
// ─────────────────────────────────────────────
model Revenue {
  id            String        @id @default(cuid())
  projectId     String?       @map("project_id")
  project       Project?      @relation(fields: [projectId], references: [id])
  clientId      String?       @map("client_id")
  client        Client?       @relation(fields: [clientId], references: [id])
  categoryId    String?       @map("category_id")
  category      Category?     @relation(fields: [categoryId], references: [id])
  createdById   String        @map("created_by_id")
  createdBy     User          @relation(fields: [createdById], references: [id])
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  dueDate       DateTime      @map("due_date")
  receivedDate  DateTime?     @map("received_date")
  status        RevenueStatus @default(PENDING)
  paymentMethod String?       @map("payment_method")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("revenues")
}

enum RevenueStatus {
  PENDING
  RECEIVED
  OVERDUE
}

// ─────────────────────────────────────────────
// APP SUBMISSIONS (FUTURO — integração mobile)
// Funcionários enviam comprovantes de compras
// via app mobile. Admin aprova ou rejeita.
// ─────────────────────────────────────────────
model AppSubmission {
  id           String           @id @default(cuid())
  employeeId   String           @map("employee_id")
  employee     User             @relation(fields: [employeeId], references: [id])
  projectId    String           @map("project_id")
  project      Project          @relation(fields: [projectId], references: [id])
  description  String
  amount       Decimal          @db.Decimal(12, 2)
  purchaseDate DateTime         @map("purchase_date")
  receiptUrl   String?          @map("receipt_url")
  status       SubmissionStatus @default(PENDING_APPROVAL)
  reviewedById String?          @map("reviewed_by_id")
  reviewedBy   User?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?        @map("reviewed_at")
  reviewNotes  String?          @map("review_notes")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("app_submissions")
}

enum SubmissionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// REFORM ITEMS — Catálogo de itens/serviços
// ─────────────────────────────────────────────
model ReformItem {
  id          String       @id @default(cuid())
  name        String
  description String?
  category    ItemCategory
  unit        ItemUnit     @default(UNIT)
  priceLow    Decimal      @db.Decimal(10, 2) @map("price_low")
  priceMedium Decimal      @db.Decimal(10, 2) @map("price_medium")
  priceHigh   Decimal      @db.Decimal(10, 2) @map("price_high")
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  budgetItems BudgetItem[]

  @@map("reform_items")
}

enum ItemCategory {
  DEMOLITION
  PAINTING
  MASONRY
  ELECTRICAL
  PLUMBING
  FINISHING
  CLEANING
  JOINERY
  TILING
  CARPENTRY
  OTHERS
}

enum ItemUnit {
  UNIT
  SQM
  M
  DAILY
  SERVICE
  POINT
  HOUR
}

// ─────────────────────────────────────────────
// BUDGETS — Orçamentos
// ─────────────────────────────────────────────
model Budget {
  id           String       @id @default(cuid())
  code         String       @unique
  clientId     String       @map("client_id")
  client       Client       @relation(fields: [clientId], references: [id])
  title        String
  tier         BudgetTier
  status       BudgetStatus @default(DRAFT)
  totalAmount  Decimal      @default(0) @db.Decimal(12, 2) @map("total_amount")
  notes        String?
  validUntil   DateTime?    @map("valid_until")
  zipCode      String?      @map("zip_code")
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  createdById  String       @map("created_by_id")
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  items      BudgetItem[]
  extraItems BudgetExtraItem[]

  @@map("budgets")
}

enum BudgetTier {
  HIGH
  MEDIUM
  LOW
}

enum BudgetStatus {
  DRAFT
  UNDER_REVIEW
  SENT
  APPROVED
  REJECTED
  CANCELLED
}

// Itens do catálogo selecionados no orçamento
model BudgetItem {
  id           String     @id @default(cuid())
  budgetId     String     @map("budget_id")
  budget       Budget     @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  reformItemId String     @map("reform_item_id")
  reformItem   ReformItem @relation(fields: [reformItemId], references: [id])
  quantity     Decimal    @db.Decimal(10, 3)
  unitPrice    Decimal    @db.Decimal(10, 2) @map("unit_price")
  subtotal     Decimal    @db.Decimal(12, 2)

  @@map("budget_items")
}

// Itens manuais/extras adicionados livremente
model BudgetExtraItem {
  id          String   @id @default(cuid())
  budgetId    String   @map("budget_id")
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name        String
  description String?
  quantity    Decimal  @db.Decimal(10, 3)
  unit        ItemUnit @default(UNIT)
  unitPrice   Decimal  @db.Decimal(10, 2) @map("unit_price")
  subtotal    Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")

  @@map("budget_extra_items")
}
