// ─────────────────────────────────────────────
// OBRAS PARCERIAS
// ─────────────────────────────────────────────

model PartnershipBuyer {
  id        String               @id @default(cuid())
  name      String
  cpfCnpj   String?              @map("cpf_cnpj")
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  notes     String?
  status    String               @default("ACTIVE")
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  projects  PartnershipProject[]
  @@map("partnership_buyers")
}

enum PartnershipProjectStatus {
  PLANNING
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

model PartnershipProject {
  id               String                   @id @default(cuid())
  name             String
  buyerId          String                   @map("buyer_id")
  buyer            PartnershipBuyer         @relation(fields: [buyerId], references: [id])
  address          String?
  description      String?
  startDate        DateTime?                @map("start_date")
  expectedEndDate  DateTime?                @map("expected_end_date")
  status           PartnershipProjectStatus @default(PLANNING)
  budgetedAmount   Decimal?                 @db.Decimal(12, 2) @map("budgeted_amount")
  notes            String?
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  materials        PartnershipMaterial[]
  partnerExpenses  PartnershipExpense[]
  partnerProviders PartnershipProvider[]
  @@map("partnership_projects")
}

model PartnershipMaterial {
  id            String             @id @default(cuid())
  projectId     String             @map("project_id")
  project       PartnershipProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description   String
  supplier      String?
  quantity      Decimal            @db.Decimal(10, 3)
  unitPrice     Decimal            @db.Decimal(12, 2) @map("unit_price")
  total         Decimal            @db.Decimal(12, 2)
  date          DateTime?
  paymentMethod String?            @map("payment_method")
  notes         String?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  @@map("partnership_materials")
}

model PartnershipExpense {
  id            String             @id @default(cuid())
  projectId     String             @map("project_id")
  project       PartnershipProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description   String
  category      String
  amount        Decimal            @db.Decimal(12, 2)
  date          DateTime?
  paymentMethod String?            @map("payment_method")
  status        String             @default("PENDING")
  notes         String?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  @@map("partnership_expenses")
}

model PartnershipProvider {
  id                 String             @id @default(cuid())
  projectId          String             @map("project_id")
  project            PartnershipProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceProviderId  String             @map("service_provider_id")
  serviceProvider    ServiceProvider    @relation("PartnerLinks", fields: [serviceProviderId], references: [id])
  serviceDescription String             @map("service_description")
  agreedAmount       Decimal?           @db.Decimal(12, 2) @map("agreed_amount")
  paidAmount         Decimal?           @db.Decimal(12, 2) @map("paid_amount")
  dueDate            DateTime?          @map("due_date")
  paymentDate        DateTime?          @map("payment_date")
  status             String             @default("PENDING")
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  @@map("partnership_providers")
}

// ─────────────────────────────────────────────
// OBRAS PESSOAIS
// ─────────────────────────────────────────────
model PersonalProject {
  id              String    @id @default(cuid())
  name            String
  address         String?
  description     String?
  startDate       DateTime? @map("start_date")
  expectedEndDate DateTime? @map("expected_end_date")
  status          String    @default("PLANNING")
  budgetedAmount  Decimal?  @db.Decimal(12, 2) @map("budgeted_amount")
  notes           String?
  // Dono do projeto pessoal — as rotas filtram por este campo.
  // Obrigatório: garante que não nasce registro sem dono (que ficaria órfão e
  // invisível). Aplicar somente APÓS o backfill dos registros existentes.
  createdById     String    @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  materials        PersonalProjectMaterial[]
  projectExpenses  PersonalProjectExpense[]
  projectProviders PersonalProjectProvider[]

  @@map("personal_projects")
}

model PersonalProjectMaterial {
  id            String          @id @default(cuid())
  projectId     String          @map("project_id")
  project       PersonalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description   String
  supplier      String?
  quantity      Decimal         @db.Decimal(10, 3)
  unitPrice     Decimal         @db.Decimal(12, 2) @map("unit_price")
  total         Decimal         @db.Decimal(12, 2)
  date          DateTime?
  paymentMethod String?         @map("payment_method")
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("personal_project_materials")
}

model PersonalProjectExpense {
  id            String          @id @default(cuid())
  projectId     String          @map("project_id")
  project       PersonalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description   String
  category      String          @default("outros")
  amount        Decimal         @db.Decimal(12, 2)
  date          DateTime?
  paymentMethod String?         @map("payment_method")
  status        String          @default("PENDING")
  notes         String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@map("personal_project_expenses")
}

model PersonalProjectProvider {
  id                 String          @id @default(cuid())
  projectId          String          @map("project_id")
  project            PersonalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceProviderId  String          @map("service_provider_id")
  serviceProvider    ServiceProvider @relation("PersonalProjectLinks", fields: [serviceProviderId], references: [id])
  serviceDescription String          @map("service_description")
  agreedAmount       Decimal?        @db.Decimal(12, 2) @map("agreed_amount")
  paidAmount         Decimal?        @db.Decimal(12, 2) @map("paid_amount")
  dueDate            DateTime?       @map("due_date")
  paymentDate        DateTime?       @map("payment_date")
  status             String          @default("PENDING")
  notes              String?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@map("personal_project_providers")
}

/// Registro de mensagens de WhatsApp enviadas — auditoria e diagnóstico.
/// Sem isso não há como saber se um funcionário foi avisado nem por que falhou.
model WhatsappLog {
  id           String   @id @default(cuid())
  kind         String                            // ASSIGNMENT_CREATED, ASSIGNMENT_UPDATED, ASSIGNMENT_CANCELLED
  status       String                            // SENT, FAILED, SKIPPED
  to           String?                           // número normalizado usado no envio
  employeeId   String?  @map("employee_id")
  assignmentId String?  @map("assignment_id")
  messageId    String?  @map("message_id")       // id devolvido pela Evolution
  error        String?                           // motivo, quando status != SENT
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([assignmentId])
  @@index([employeeId, createdAt])
  @@map("whatsapp_logs")
}

/// Cobrança gerada para o cliente no Mercado Pago.
/// `items` guarda o que estava sendo cobrado no momento da criação, para que a
/// confirmação marque exatamente aqueles itens — e não o que estiver pendente
/// quando a notificação chegar.
model Payment {
  id             String        @id @default(cuid())
  clientId       String        @map("client_id")
  client         Client        @relation(fields: [clientId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  /// [{ "type": "material" | "extra_service", "id": "...", "amount": 0 }]
  items          Json
  provider       String        @default("mercadopago")
  preferenceId   String?       @map("preference_id")
  /// URL do checkout, para o cliente retomar um pagamento pendente.
  checkoutUrl    String?       @map("checkout_url")
  providerPaymentId String?    @unique @map("provider_payment_id")
  paymentMethod  String?       @map("payment_method")
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([clientId, status])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

/// Registro de toda notificação recebida do gateway — auditoria, idempotência e
/// diagnóstico da validação de assinatura.
model PaymentWebhookLog {
  id           String   @id @default(cuid())
  provider     String   @default("mercadopago")
  topic        String?
  resourceId   String?  @map("resource_id")
  signatureOk  Boolean  @default(false) @map("signature_ok")
  handled      Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([resourceId])
  @@index([createdAt])
  @@map("payment_webhook_logs")
}
