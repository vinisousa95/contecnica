generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true) @map("is_active")
  phone        String?
  avatar       String?
  financePin   String?  @map("finance_pin")
  // Incrementado ao trocar a senha ou desativar o usuário: invalida todos os
  // JWTs já emitidos (que carregam a versão vigente no momento da emissão).
  tokenVersion Int      @default(0) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  expenses            Expense[]
  revenues            Revenue[]
  appSubmissions      AppSubmission[]
  reviewedSubmissions AppSubmission[] @relation("ReviewedBy")
  budgets             Budget[]
  createdTasks        Task[]          @relation("TaskCreator")
  personalExpenses    PersonalExpense[] @relation("PersonalExpenseCreator")
  contracts           Contract[]      @relation("ContractCreator")

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

// ─────────────────────────────────────────────
// CLIENTS
// ─────────────────────────────────────────────
model Client {
  id           String       @id @default(cuid())
  name         String
  document     String?      @unique
  phone        String?
  email        String?
  zipCode      String?      @map("zip_code")
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  notes        String?
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  projects    Project[]
  revenues    Revenue[]
  budgets     Budget[]
  portalUsers ClientUser[]
  contracts   Contract[]
  payments    Payment[]

  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

// ─────────────────────────────────────────────
// PROJECTS (OBRAS)
// ─────────────────────────────────────────────
model Project {
  id              String        @id @default(cuid())
  name            String
  clientId        String        @map("client_id")
  client          Client        @relation(fields: [clientId], references: [id])
  zipCode         String?       @map("zip_code")
  street          String?
  number          String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?
  description     String?
  startDate       DateTime?     @map("start_date")
  expectedEndDate DateTime?     @map("expected_end_date")
  actualEndDate   DateTime?     @map("actual_end_date")
  status          ProjectStatus @default(PLANNING)
  budget          Decimal?      @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  progress         Int           @default(0)
  coverPhoto       String?       @map("cover_photo")
  linkedBudgetId   String?       @map("linked_budget_id")
  linkedBudget     Budget?       @relation(fields: [linkedBudgetId], references: [id])
  expenses         Expense[]
  revenues         Revenue[]
  appSubmissions   AppSubmission[]
  updates          ProjectUpdate[]
  photos           ProjectPhoto[]
  documents        ProjectDocument[]
  tasks            ProjectTask[]
  workTasks           Task[]
  assignments         WorkAssignment[]
  extraServices       ExtraService[]
  serviceProviders    WorkServiceProvider[]
  contracts           Contract[]

  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// CATEGORIES
// ─────────────────────────────────────────────
model Category {
  id        String       @id @default(cuid())
  name      String       @unique
  type      CategoryType
  color     String?
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")

  expenses Expense[]
  revenues Revenue[]

  @@map("categories")
}

enum CategoryType {
  EXPENSE
  INCOME
  BOTH
}

// ─────────────────────────────────────────────
// EXPENSES (CONTAS A PAGAR)
// ─────────────────────────────────────────────
model Expense {
  id            String        @id @default(cuid())
  projectId     String?       @map("project_id")
  project       Project?      @relation(fields: [projectId], references: [id])
  categoryId    String?       @map("category_id")
  category      Category?     @relation(fields: [categoryId], references: [id])
  createdById   String        @map("created_by_id")
  createdBy     User          @relation(fields: [createdById], references: [id])
  description   String
  supplier      String?
  amount        Decimal       @db.Decimal(12, 2)
  dueDate       DateTime      @map("due_date")
  paymentDate   DateTime?     @map("payment_date")
  status        ExpenseStatus @default(PENDING)
  paymentMethod   String?       @map("payment_method")
  attachmentUrl   String?       @map("attachment_url")
  notes           String?
  /// LEGADO — nunca foi lido por nenhuma tela. Quem controla o que o cliente vê
  /// são `billedToClient` e `receiptShared`. Mantido só para não exigir uma
  /// migração destrutiva; pode ser removido numa próxima.
  visibleInPortal Boolean       @default(false) @map("visible_in_portal")

  /// Material enviado para cobrança do cliente (aba Reembolso de Materiais na
  /// obra). É o que faz o item aparecer em Cobranças no portal.
  ///
  /// Antes disso, o critério era "categoria com 'material' no nome": todo
  /// material entrava na cobrança sozinho, e material de categoria com outro
  /// nome nunca entrava. Agora é decisão explícita de quem lança.
  billedToClient   Boolean      @default(false) @map("billed_to_client")
  billedToClientAt DateTime?    @map("billed_to_client_at")

  /// Nota fiscal liberada para o cliente. Sem isto o anexo não é exposto no
  /// portal nem pode ser baixado por uma sessão de cliente.
  receiptShared    Boolean      @default(false) @map("receipt_shared")

  // Reembolso pelo CLIENTE. Distinto de `status`: PAID ali significa que a
  // Contécnica pagou o fornecedor, não que o cliente reembolsou.
  clientPaid      Boolean       @default(false) @map("client_paid")
  clientPaidAt    DateTime?     @map("client_paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  workServiceProviders WorkServiceProvider[]
  workAssignment       WorkAssignment?       @relation("AssignmentExpense")

  @@map("expenses")
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
}

// ─────────────────────────────────────────────
// REVENUES (CONTAS A RECEBER)
// ─────────────────────────────────────────────
model Revenue {
  id            String        @id @default(cuid())
  projectId     String?       @map("project_id")
  project       Project?      @relation(fields: [projectId], references: [id])
  clientId      String?       @map("client_id")
  client        Client?       @relation(fields: [clientId], references: [id])
  categoryId    String?       @map("category_id")
  category      Category?     @relation(fields: [categoryId], references: [id])
  createdById   String        @map("created_by_id")
  createdBy     User          @relation(fields: [createdById], references: [id])
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  dueDate       DateTime      @map("due_date")
  receivedDate  DateTime?     @map("received_date")
  status        RevenueStatus @default(PENDING)
  paymentMethod String?       @map("payment_method")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("revenues")
}

enum RevenueStatus {
  PENDING
  RECEIVED
  OVERDUE
}

// ─────────────────────────────────────────────
// APP SUBMISSIONS (FUTURO — integração mobile)
// Funcionários enviam comprovantes de compras
// via app mobile. Admin aprova ou rejeita.
// ─────────────────────────────────────────────
model AppSubmission {
  id           String           @id @default(cuid())
  employeeId   String           @map("employee_id")
  employee     User             @relation(fields: [employeeId], references: [id])
  projectId    String           @map("project_id")
  project      Project          @relation(fields: [projectId], references: [id])
  description  String
  amount       Decimal          @db.Decimal(12, 2)
  purchaseDate DateTime         @map("purchase_date")
  receiptUrl   String?          @map("receipt_url")
  status       SubmissionStatus @default(PENDING_APPROVAL)
  reviewedById String?          @map("reviewed_by_id")
  reviewedBy   User?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?        @map("reviewed_at")
  reviewNotes  String?          @map("review_notes")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("app_submissions")
}

enum SubmissionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// REFORM ITEMS — Catálogo de itens/serviços
// ─────────────────────────────────────────────
model ReformItem {
  id             String       @id @default(cuid())
  name           String
  description    String?
  category       ItemCategory
  customCategory String?      @map("custom_category")
  unit           ItemUnit     @default(UNIT)
  priceLow       Decimal      @db.Decimal(10, 2) @map("price_low")
  priceMedium    Decimal      @db.Decimal(10, 2) @map("price_medium")
  priceHigh      Decimal      @db.Decimal(10, 2) @map("price_high")
  isActive       Boolean      @default(true) @map("is_active")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  budgetItems  BudgetItem[]
  packageItems ReformPackageItem[]

  @@map("reform_items")
}

enum ItemCategory {
  DEMOLITION
  PAINTING
  MASONRY
  ELECTRICAL
  PLUMBING
  FINISHING
  CLEANING
  JOINERY
  TILING
  CARPENTRY
  OTHERS
}

enum ItemUnit {
  UNIT
  SQM
  M
  ML
  DAILY
  SERVICE
  POINT
  HOUR
}

// ─────────────────────────────────────────────
// REFORM PACKAGES — Ambientes
// ─────────────────────────────────────────────
model ReformPackage {
  id             String              @id @default(cuid())
  name           String
  description    String?
  category       ItemCategory        @default(OTHERS)
  customCategory String?             @map("custom_category")
  priceLow       Decimal             @db.Decimal(10, 2) @map("price_low")
  priceMedium    Decimal             @db.Decimal(10, 2) @map("price_medium")
  priceHigh      Decimal             @db.Decimal(10, 2) @map("price_high")
  isActive       Boolean             @default(true) @map("is_active")
  sortOrder      Int                 @default(0) @map("sort_order")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  items       ReformPackageItem[]
  budgetItems BudgetItem[]

  @@map("reform_packages")
}

model ReformPackageItem {
  id              String        @id @default(cuid())
  packageId       String        @map("package_id")
  package         ReformPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  reformItemId    String?       @map("reform_item_id")
  reformItem      ReformItem?   @relation(fields: [reformItemId], references: [id], onDelete: SetNull)
  name            String
  description     String?
  quantity        Decimal       @db.Decimal(10, 3) @default(1)
  unit            ItemUnit      @default(UNIT)
  unitPriceLow    Decimal?      @db.Decimal(10, 2) @map("unit_price_low")
  unitPriceMedium Decimal?      @db.Decimal(10, 2) @map("unit_price_medium")
  unitPriceHigh   Decimal?      @db.Decimal(10, 2) @map("unit_price_high")
  sortOrder       Int           @default(0) @map("sort_order")

  @@map("reform_package_items")
}

// ─────────────────────────────────────────────
// BUDGETS — Orçamentos
// ─────────────────────────────────────────────
model Budget {
  id           String       @id @default(cuid())
  code         String       @unique
  clientId     String       @map("client_id")
  client       Client       @relation(fields: [clientId], references: [id])
  title        String
  tier         BudgetTier
  status       BudgetStatus @default(DRAFT)
  totalAmount  Decimal      @default(0) @db.Decimal(12, 2) @map("total_amount")
  discount     Decimal      @default(0) @db.Decimal(10, 6)
  notes        String?
  validUntil   DateTime?    @map("valid_until")
  zipCode      String?      @map("zip_code")
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  createdById  String       @map("created_by_id")
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  items          BudgetItem[]
  extraItems     BudgetExtraItem[]
  linkedProjects Project[]

  @@map("budgets")
}

enum BudgetTier {
  HIGH
  MEDIUM
  LOW
}

enum BudgetStatus {
  DRAFT
  UNDER_REVIEW
  SENT
  APPROVED
  REJECTED
  CANCELLED
}

// Itens do catálogo selecionados no orçamento
model BudgetItem {
  id              String         @id @default(cuid())
  budgetId        String         @map("budget_id")
  budget          Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  reformItemId    String?        @map("reform_item_id")
  reformItem      ReformItem?    @relation(fields: [reformItemId], references: [id])
  reformPackageId String?        @map("reform_package_id")
  reformPackage   ReformPackage? @relation(fields: [reformPackageId], references: [id])
  name            String?
  quantity        Decimal        @db.Decimal(10, 3)
  unitPrice       Decimal        @db.Decimal(10, 2) @map("unit_price")
  subtotal        Decimal        @db.Decimal(12, 2)

  @@map("budget_items")
}

// ─────────────────────────────────────────────
// CLIENT PORTAL
// ─────────────────────────────────────────────

model ClientUser {
  id           String    @id @default(cuid())
  clientId     String    @map("client_id")
  client       Client    @relation(fields: [clientId], references: [id])
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("client_users")
}

model ProjectUpdate {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("project_updates")
}

model ProjectPhoto {
  id          String       @id @default(cuid())
  projectId   String       @map("project_id")
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId      String?      @map("task_id")
  task        ProjectTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  imageUrl    String       @map("image_url")
  description String?
  visible     Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("project_photos")
}

model ProjectDocument {
  id          String           @id @default(cuid())
  projectId   String           @map("project_id")
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  fileUrl     String           @map("file_url")
  type        DocumentType     @default(OTHER)
  visible     Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at")

  @@map("project_documents")
}

enum DocumentType {
  CONTRACT
  BUDGET
  INVOICE
  REPORT
  OTHER
}

model ProjectTask {
  id           String    @id @default(cuid())
  projectId    String    @map("project_id")
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  isCompleted  Boolean   @default(false) @map("is_completed")
  completedAt  DateTime? @map("completed_at")
  showInPortal Boolean        @default(true) @map("show_in_portal")
  order        Int            @default(0)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  photos       ProjectPhoto[]

  @@map("project_tasks")
}

// Itens manuais/extras adicionados livremente
model BudgetExtraItem {
  id          String   @id @default(cuid())
  budgetId    String   @map("budget_id")
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name        String
  description String?
  room        String?
  quantity    Decimal  @db.Decimal(10, 3)
  unit        ItemUnit @default(UNIT)
  unitPrice   Decimal  @db.Decimal(10, 2) @map("unit_price")
  subtotal    Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0) @map("sort_order")

  @@map("budget_extra_items")
}

model ExtraItemTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  unit        ItemUnit @default(UNIT)
  unitPrice   Decimal  @db.Decimal(10, 2) @map("unit_price")
  usageCount  Int      @default(1) @map("usage_count")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("extra_item_templates")
}

// ─────────────────────────────────────────────
// OPERATIONAL — Employees, Vehicles, Assignments
// ─────────────────────────────────────────────
model Employee {
  id            String         @id @default(cuid())
  name          String
  cpf           String?
  rg            String?
  phone         String?
  // Receber avisos de deslocamento por WhatsApp. Padrão ligado: é comunicado
  // operacional sobre o próprio trabalho, não divulgação. Desligue por
  // funcionário quando ele não quiser (ou não tiver WhatsApp).
  whatsappEnabled Boolean @default(true) @map("whatsapp_enabled")
  role          String?
  birthDate     DateTime?      @map("birth_date")
  street        String?
  number        String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?
  zipCode       String?        @map("zip_code")
  dailyRate          Decimal?       @db.Decimal(10, 2) @map("daily_rate")
  monthlyRate        Decimal?       @db.Decimal(10, 2) @map("monthly_rate")
  contractStartDate  DateTime?      @map("contract_start_date")
  contractEndDate    DateTime?      @map("contract_end_date")
  contractCity       String?        @map("contract_city")
  status        EmployeeStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  assignments   WorkAssignment[]
  assignedTasks Task[]           @relation("TaskAssignee")
  absences      EmployeeAbsence[]
  fines         VehicleFine[]

  @@map("employees")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

model EmployeeAbsence {
  id          String    @id @default(cuid())
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  reason      String
  notes       String?
  justified   Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("employee_absences")
}

// ─────────────────────────────────────────────
// TASK EXECUTION (Execução de Tarefas)
// ─────────────────────────────────────────────
model Task {
  id          String       @id @default(cuid())
  projectId   String       @map("project_id")
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  assigneeId  String?      @map("assignee_id")
  assignee    Employee?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  parentId    String?      @map("parent_id")
  parent      Task?        @relation("TaskChildren", fields: [parentId], references: [id])
  children    Task[]       @relation("TaskChildren")
  dueDate     DateTime?    @map("due_date")
  completedAt DateTime?    @map("completed_at")
  createdById String       @map("created_by_id")
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("tasks")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model Vehicle {
  id          String        @id @default(cuid())
  name        String
  model       String?
  plate       String?       @unique
  type        String?
  color       String?
  year        Int?
  status                VehicleStatus @default(ACTIVE)
  notes                 String?
  // Manutenção — Troca de Óleo
  currentKm             Int?          @map("current_km")
  lastOilChangeDate     DateTime?     @map("last_oil_change_date")
  lastOilChangeKm       Int?          @map("last_oil_change_km")
  oilChangeIntervalKm   Int?          @map("oil_change_interval_km")
  oilChangeIntervalDays Int?          @map("oil_change_interval_days")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  assignments           WorkAssignment[]
  fines                 VehicleFine[]
  maintenances          VehicleMaintenance[]

  @@map("vehicles")
}

model VehicleMaintenance {
  id          String   @id @default(cuid())
  vehicleId   String   @map("vehicle_id")
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime
  type        String
  description String?
  km          Int?
  cost        Decimal? @db.Decimal(10, 2)
  workshop    String?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("vehicle_maintenances")
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model WorkAssignment {
  id              String           @id @default(cuid())
  employeeId      String           @map("employee_id")
  employee        Employee         @relation(fields: [employeeId], references: [id])
  vehicleId       String?          @map("vehicle_id")
  vehicle         Vehicle?         @relation(fields: [vehicleId], references: [id])
  projectId       String           @map("project_id")
  project         Project          @relation(fields: [projectId], references: [id])
  date            DateTime
  departureTime   String?          @map("departure_time")
  returnTime      String?          @map("return_time")
  notes           String?
  status          AssignmentStatus @default(SCHEDULED)
  workedConfirmed Boolean          @default(false) @map("worked_confirmed")
  expenseId       String?          @unique @map("expense_id")
  expense         Expense?         @relation("AssignmentExpense", fields: [expenseId], references: [id])
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  fines           VehicleFine[]

  @@map("work_assignments")
}

enum AssignmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// SERVICE PROVIDERS — Prestadores de Serviços
// ─────────────────────────────────────────────
model ServiceProvider {
  id             String                    @id @default(cuid())
  name           String
  type           ServiceProviderType       @default(INDIVIDUAL)
  documentNumber String?                   @map("document_number")
  birthDate      DateTime?                 @map("birth_date")
  phone          String?
  email          String?
  specialty      ServiceProviderSpecialty  @default(OTHER)
  street         String?
  number         String?
  complement     String?
  neighborhood   String?
  city           String?
  state          String?
  zipCode        String?                   @map("zip_code")
  pixKey         String?                   @map("pix_key")
  bankInfo       String?                   @map("bank_info")
  notes          String?
  status         ServiceProviderStatus     @default(ACTIVE)
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  workLinks            WorkServiceProvider[]
  partnerLinks         PartnershipProvider[]       @relation("PartnerLinks")
  personalProjectLinks PersonalProjectProvider[]   @relation("PersonalProjectLinks")

  @@map("service_providers")
}

model WorkServiceProvider {
  id                  String              @id @default(cuid())
  projectId           String              @map("project_id")
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceProviderId   String              @map("service_provider_id")
  serviceProvider     ServiceProvider     @relation(fields: [serviceProviderId], references: [id])
  serviceDescription  String              @map("service_description")
  startDate           DateTime?           @map("start_date")
  expectedEndDate     DateTime?           @map("expected_end_date")
  agreedAmount        Decimal?            @db.Decimal(12, 2) @map("agreed_amount")
  status              WorkProviderStatus  @default(PENDING)
  notes               String?
  expenseId           String?             @map("expense_id")
  expense             Expense?            @relation(fields: [expenseId], references: [id])
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@map("work_service_providers")
}

enum ServiceProviderType {
  INDIVIDUAL
  COMPANY
}

enum ServiceProviderStatus {
  ACTIVE
  INACTIVE
}

enum ServiceProviderSpecialty {
  ELECTRICAL
  PLUMBING
  PAINTING
  MASONRY
  FINISHING
  DRYWALL
  CARPENTRY
  METALWORK
  GLASSWORK
  CLEANING
  TRANSPORT
  ENGINEERING
  ARCHITECTURE
  OTHER
}

enum WorkProviderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELED
}

