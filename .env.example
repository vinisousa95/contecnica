# Database
DATABASE_URL="postgresql://user:password@localhost:5432/contecnica"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"

# Diretório de uploads (fotos/documentos). Padrão: ~/.contecnica-uploads
UPLOAD_DIR=""

# Leitura de notas fiscais por IA (app mobile → /api/v1/scan-receipt).
# SEGREDO DE SERVIDOR: nunca prefixe com NEXT_PUBLIC_ nem EXPO_PUBLIC_,
# senão vai para o bundle do frontend. Obtenha em https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Upload (futuro - S3 ou Cloudflare R2)
# UPLOAD_PROVIDER="local"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# AWS_BUCKET_NAME=""
