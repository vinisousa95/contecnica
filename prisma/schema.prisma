generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true) @map("is_active")
  phone        String?
  avatar       String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  expenses            Expense[]
  revenues            Revenue[]
  appSubmissions      AppSubmission[]
  reviewedSubmissions AppSubmission[] @relation("ReviewedBy")

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

// ─────────────────────────────────────────────
// CLIENTS
// ─────────────────────────────────────────────
model Client {
  id           String       @id @default(cuid())
  name         String
  document     String?      @unique
  phone        String?
  email        String?
  zipCode      String?      @map("zip_code")
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  notes        String?
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  projects Project[]
  revenues Revenue[]

  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

// ─────────────────────────────────────────────
// PROJECTS (OBRAS)
// ─────────────────────────────────────────────
model Project {
  id              String        @id @default(cuid())
  name            String
  clientId        String        @map("client_id")
  client          Client        @relation(fields: [clientId], references: [id])
  zipCode         String?       @map("zip_code")
  street          String?
  number          String?
  complement      String?
  neighborhood    String?
  city            String?
  state           String?
  description     String?
  startDate       DateTime?     @map("start_date")
  expectedEndDate DateTime?     @map("expected_end_date")
  actualEndDate   DateTime?     @map("actual_end_date")
  status          ProjectStatus @default(PLANNING)
  budget          Decimal?      @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  expenses       Expense[]
  revenues       Revenue[]
  appSubmissions AppSubmission[]

  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

// ─────────────────────────────────────────────
// CATEGORIES
// ─────────────────────────────────────────────
model Category {
  id        String       @id @default(cuid())
  name      String       @unique
  type      CategoryType
  color     String?
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")

  expenses Expense[]
  revenues Revenue[]

  @@map("categories")
}

enum CategoryType {
  EXPENSE
  INCOME
  BOTH
}

// ─────────────────────────────────────────────
// EXPENSES (CONTAS A PAGAR)
// ─────────────────────────────────────────────
model Expense {
  id            String        @id @default(cuid())
  projectId     String?       @map("project_id")
  project       Project?      @relation(fields: [projectId], references: [id])
  categoryId    String?       @map("category_id")
  category      Category?     @relation(fields: [categoryId], references: [id])
  createdById   String        @map("created_by_id")
  createdBy     User          @relation(fields: [createdById], references: [id])
  description   String
  supplier      String?
  amount        Decimal       @db.Decimal(12, 2)
  dueDate       DateTime      @map("due_date")
  paymentDate   DateTime?     @map("payment_date")
  status        ExpenseStatus @default(PENDING)
  paymentMethod String?       @map("payment_method")
  attachmentUrl String?       @map("attachment_url")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("expenses")
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
}

// ─────────────────────────────────────────────
// REVENUES (CONTAS A RECEBER)
// ─────────────────────────────────────────────
model Revenue {
  id            String        @id @default(cuid())
  projectId     String?       @map("project_id")
  project       Project?      @relation(fields: [projectId], references: [id])
  clientId      String?       @map("client_id")
  client        Client?       @relation(fields: [clientId], references: [id])
  categoryId    String?       @map("category_id")
  category      Category?     @relation(fields: [categoryId], references: [id])
  createdById   String        @map("created_by_id")
  createdBy     User          @relation(fields: [createdById], references: [id])
  description   String
  amount        Decimal       @db.Decimal(12, 2)
  dueDate       DateTime      @map("due_date")
  receivedDate  DateTime?     @map("received_date")
  status        RevenueStatus @default(PENDING)
  paymentMethod String?       @map("payment_method")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@map("revenues")
}

enum RevenueStatus {
  PENDING
  RECEIVED
  OVERDUE
}

// ─────────────────────────────────────────────
// APP SUBMISSIONS (FUTURO — integração mobile)
// Funcionários enviam comprovantes de compras
// via app mobile. Admin aprova ou rejeita.
// ─────────────────────────────────────────────
model AppSubmission {
  id           String           @id @default(cuid())
  employeeId   String           @map("employee_id")
  employee     User             @relation(fields: [employeeId], references: [id])
  projectId    String           @map("project_id")
  project      Project          @relation(fields: [projectId], references: [id])
  description  String
  amount       Decimal          @db.Decimal(12, 2)
  purchaseDate DateTime         @map("purchase_date")
  receiptUrl   String?          @map("receipt_url")
  status       SubmissionStatus @default(PENDING_APPROVAL)
  reviewedById String?          @map("reviewed_by_id")
  reviewedBy   User?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?        @map("reviewed_at")
  reviewNotes  String?          @map("review_notes")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("app_submissions")
}

enum SubmissionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}
